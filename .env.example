# Copy to .env.local for local development. On Vercel, set these in the project's
# Environment settings instead; never commit real values.

# Neon Postgres connection string (Neon includes ?sslmode=require). On Vercel, use the
# pooled string (host contains -pooler).
DATABASE_URL=

# Passcode the teacher types on the Teacher page to add and edit songs.
EDITOR_PASSCODE=

# Optional: a long random string used to sign the teacher's sign-in cookie.
# If unset, one is derived from EDITOR_PASSCODE.
SESSION_SECRET=

# Optional: password shared with the YouTube helper (see helper/README.md). When set,
# YouTube downloads go through the helper instead of this server.
HELPER_TOKEN=

# Optional: the Google Cloud audio service (cloud/audio-service/README.md). Lets
# students hear songs in the key they pick. The helper above is the backup.
AUDIO_SERVICE_URL=
AUDIO_SERVICE_TOKEN=
